# Copy this file to .env and fill in the key for the provider you selected.
# Never commit the real .env file.

# --- LLM provider (required) ------------------------------------------------
# Which provider handles the analysis: openai (default) or gemini.
# Only the selected provider needs an API key.
LLM_PROVIDER=openai

OPENAI_API_KEY=
# Leave empty to use the default model (gpt-6.1-terra).
OPENAI_MODEL=

GEMINI_API_KEY=
# Leave empty to use the default model (gemini-4-hydrogen).
GEMINI_MODEL=

# --- LLM behaviour (optional) -----------------------------------------------
# Second provider to try when the primary one fails. Needs its own API key.
# LLM_FALLBACK_PROVIDER=gemini
# Reasoning effort passed to OpenAI reasoning models; leave unset for the model default.
# OPENAI_REASONING_EFFORT=low
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=2
# LLM_MAX_OUTPUT_TOKENS=8000

# --- Server (optional) ------------------------------------------------------
# Hosting platforms such as Render and Railway set PORT automatically.
# PORT=4000
# HOST=0.0.0.0
# ENVIRONMENT=production
# LOG_LEVEL=INFO
# json (default, for production) or text (easier to read locally)
# LOG_FORMAT=json

# --- Website extraction (optional) ------------------------------------------
# MAX_PAGES=5
# MAX_CONTENT_CHARS=24000
# FETCH_TIMEOUT_SECONDS=10
# FETCH_TOTAL_TIMEOUT_SECONDS=30
# ALLOWED_PORTS=80,443

# --- Result cache (optional) ------------------------------------------------
# Seconds an analysis stays cached per URL; 0 disables the cache.
# CACHE_TTL_SECONDS=3600
